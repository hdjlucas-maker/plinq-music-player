{
  "name": "plinq-music-player",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": ".",

  "d1_databases": [
    {
      "binding": "PLINQ_BINDING",
      "database_name": "plinq-db",
      "database_id": "07611a4d-1f87-4570-be79-0e2900708344"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "43bff39aca584401951aa0ba6a31b51b"
    }
  ]

  // Variáveis de ambiente (AUTH_SECRET, INFINITEPAY_HANDLE, APP_BASE_URL)
  // NÃO ficam aqui — configure como Secrets/Variáveis no painel do Cloudflare Pages
  // (Settings > Environment variables) ou via `wrangler pages secret put`.
  // Ver SETUP-LICENCA.md para o passo a passo completo.
}
