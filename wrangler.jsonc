    }
  ],

  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "43bff39aca584401951aa0ba6a31b51b"
    }
  ],

  // Configure YOUTUBE_API_KEY como Secret no Cloudflare Pages.
  // Não grave chaves de API no repositório.
}
