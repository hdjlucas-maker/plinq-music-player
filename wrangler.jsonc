{
  "name": "plinq-music-player",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": ".",

  "d1_databases": [
    {
      "binding": "PLINQ_BINDING",
      "database_name": "plinq-db",
      "database_id": "07611a4d-1f87-4570-be79-0e2900708344"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "43bff39aca584401951aa0ba6a31b51b"
    }
  ],

  "vars": {
    "INFINITEPAY_HANDLE": "servicoslucas",
    "APP_BASE_URL": "https://plinq-music-player.pages.dev"
  }

  // AUTH_SECRET é diferente: é um segredo (dado sensível, usado pra assinar sessões
  // de login), então NÃO fica aqui em texto puro. Adicione ele só pelo dashboard:
  // Settings > Variables and secrets > Add > tipo "Secret".
}
